# ==============================================================================
# COLLEGE PLACEMENT ASSESSMENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# Never commit the actual .env file or real secrets to source control.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL 8.x Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=college_placement_db

# Prisma Connection URL (used by Prisma ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_mysql_password_here@localhost:3306/college_placement_db"

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
