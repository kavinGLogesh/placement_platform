{
  "name": "college-placement-backend",
  "version": "1.0.0",
  "description": "Backend REST API for College Placement Assessment Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:check": "tsx src/config/dbCheck.ts",
    "test:auth": "tsx --test --import ./tests/setup.ts tests/auth.test.ts",
    "test:management": "tsx --test --import ./tests/setup.ts tests/management.test.ts",
    "test:questions": "tsx --test --import ./tests/setup.ts tests/question.test.ts",
    "test:assessment": "tsx --test --import ./tests/setup.ts tests/assessment.test.ts",
    "test:attempt": "tsx --test --import ./tests/setup.ts tests/attempt.test.ts",
    "test:coding": "tsx --test --import ./tests/setup.ts tests/coding.test.ts",
    "test:analytics": "tsx --test --import ./tests/setup.ts tests/analytics.test.ts",
    "test:report": "tsx --test --import ./tests/setup.ts tests/report.test.ts",
    "test:roles": "tsx --test --import ./tests/setup.ts tests/role_separation.test.ts",
    "test:progress": "tsx --test --import ./tests/setup.ts tests/student_performance_progress.test.ts",
    "test:student-flow": "tsx --test --import ./tests/setup.ts tests/student_account_flow.test.ts",
    "test:audit-gaps": "tsx --test --import ./tests/setup.ts tests/critical_audit_gaps.test.ts",
    "test:anti-cheating": "tsx --test --import ./tests/setup.ts tests/advanced_anti_cheating.test.ts",
    "test:evaluation": "tsx --test --import ./tests/setup.ts tests/structured_evaluation.test.ts",
    "test:company": "tsx --test --import ./tests/setup.ts tests/company_assessment.test.ts",
    "test:company-intelligence": "tsx --test --import ./tests/setup.ts tests/company_intelligence.test.ts",
    "test:attendance": "tsx --test --import ./tests/setup.ts tests/assessment_attendance.test.ts",
    "test:all": "tsx --test --import ./tests/setup.ts tests/auth.test.ts tests/management.test.ts tests/question.test.ts tests/assessment.test.ts tests/attempt.test.ts tests/coding.test.ts tests/analytics.test.ts tests/report.test.ts tests/role_separation.test.ts tests/student_account_flow.test.ts tests/critical_audit_gaps.test.ts tests/advanced_anti_cheating.test.ts tests/structured_evaluation.test.ts tests/company_assessment.test.ts tests/company_intelligence.test.ts tests/assessment_attendance.test.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "mysql",
    "placement-platform"
  ],
  "author": "Engineering Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^0.3.29",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.1"
  }
}
