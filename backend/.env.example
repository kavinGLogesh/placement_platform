# ==============================================================================
# COLLEGE PLACEMENT ASSESSMENT PLATFORM - BACKEND ENVIRONMENT TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in the backend folder:
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
# 2. Fill in your environment-specific credentials and secrets below.
# 3. NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for Express API server
PORT=5000

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS origins (comma-separated list for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8.x & Prisma ORM)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=college_placement_db

# Prisma connection string (used by Prisma CLI & Prisma Client)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_mysql_password_here@localhost:3306/college_placement_db"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Secret key used to sign access tokens (min 32 random characters recommended for production)
JWT_SECRET=your_super_secret_jwt_access_key_min_32_characters

# Access token expiration time (e.g., 15m, 1h, 1d)
JWT_EXPIRES_IN=15m

# Secret key used to sign refresh tokens
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters

# Refresh token expiration time (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. AI INTELLIGENCE & DOCUMENT IMPORT (Google Gemini API)
# ------------------------------------------------------------------------------
# API key for Gemini question classification and AI document analysis
# Get an API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model used for parsing & classification
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. CODING ASSESSMENT / CODE EXECUTION (Judge0 API - Optional)
# ------------------------------------------------------------------------------
# Base URL for Judge0 CE/Extra CE code execution engine
JUDGE0_URL=http://localhost:2358

# RapidAPI / Self-hosted Judge0 API key (leave blank for local CE instance)
JUDGE0_API_KEY=

# Execution timeout in milliseconds (default: 10000ms)
JUDGE0_TIMEOUT_MS=10000

# Set to true to use built-in mock compiler sandbox without external Judge0 server
USE_MOCK_JUDGE0=true
